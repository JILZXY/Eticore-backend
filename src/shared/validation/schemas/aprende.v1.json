{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aprende v1",
  "type": "object",
  "required": ["objetivo", "secciones", "ejemplo"],
  "properties": {
    "objetivo": { "type": "string", "minLength": 1 },
    "secciones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "orden", "titulo"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "orden": { "type": "integer", "minimum": 1 },
          "titulo": { "type": "string", "minLength": 1 },
          "cuerpo": { "type": "string", "minLength": 1 },
          "contenido": { "type": "string", "minLength": 1 },
          "referencia_local": { "type": "string", "minLength": 1 },
          "referencias_locales": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "ejemplo": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["descripcion"],
          "properties": {
            "titulo": { "type": "string", "minLength": 1 },
            "descripcion": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "buenas_practicas": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
